{
	"name": "jcv-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"fix": "bun --bun turbo run fix && oxfmt docs",
		"build": "bun --bun turbo run build",
		"check": "bun --bun turbo run check",
		"dev": "bun --bun turbo run dev",
		"check:docs": "bun --bun oxfmt --check docs README.md"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^0.24.0",
		"terser": "^5.49.0",
		"tsdown": "^0.22.13",
		"turbo": "^2.10.6",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"engines": {
		"bun": "1.3.13",
		"node": ">=18"
	}
}
