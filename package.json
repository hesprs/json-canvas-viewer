{
	"name": "jcv-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"fix": "turbo run fix && oxfmt docs README.md",
		"build": "turbo run build",
		"check": "turbo run check",
		"check:docs": "oxfmt --check docs README.md",
		"dev": "turbo run dev"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.64.0",
		"oxlint": "1.78",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "^0.22.14",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	},
	"packageManager": "bun@1.3.13"
}
